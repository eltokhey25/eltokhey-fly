# --- Environment / secrets (NEVER commit) ---
.env
.env.*
.env.local
.env.save
.env.backup
*.env
!.env.example

# --- Databases ---
*.sqlite3
*.sqlite3.backup
db.sqlite3

# --- Backups ---
*.bak
*.backup

# --- Media / uploads ---
# Anchored with a leading slash on purpose: a bare "media/" also matched
# hajj_umrah/dashboard/templates/dashboard/media/, which silently kept the
# dashboard's media templates out of the repository.
/media/
/hajj_umrah/media/

# --- Collected static ---
# Anchored: an unanchored "staticfiles/" would also swallow any directory with
# that name inside an app.
/staticfiles/
/hajj_umrah/staticfiles/

# --- Python ---
__pycache__/
*.py[cod]
*.pyc

# --- Virtualenvs ---
venv/
.venv/
env/

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Old PHP project backed up locally (kept out of the repo) ---
_old-php-backup/
