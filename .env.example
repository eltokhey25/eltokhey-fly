# Django core
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Email (SMTP) ---
# Gmail example:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=your@gmail.com
#   EMAIL_HOST_PASSWORD=your-16-char-app-password
#   DEFAULT_FROM_EMAIL="Hajj & Umrah <your@gmail.com>"
#   ADMIN_NOTIFICATION_EMAIL=receiver@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Where new-booking alerts are sent (the site owner)
ADMIN_NOTIFICATION_EMAIL=
# Optional: force a backend ('django.core.mail.backends.smtp.EmailBackend'
# is auto-selected when EMAIL_HOST_USER + EMAIL_HOST_PASSWORD are set,
# otherwise the console backend is used for development).
#EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend