DJANGO_SECRET_KEY=your-secret-key-here-change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
ADMIN_NOTIFICATION_EMAIL=your-email@gmail.com
GROQ_API_KEY=your-groq-api-key-here
# Optional. Defaults to openai/gpt-oss-120b. List what your key can actually
# use with: curl -H "Authorization: Bearer $GROQ_API_KEY" \
#   https://api.groq.com/openai/v1/models
# (llama-3.3-70b-versatile is Enterprise-only and is not on the developer plan.)
#GROQ_MODEL=openai/gpt-oss-120b

# --- Chatbot rate limiting ---
# Per visitor, per hour. Caps how much Groq spend one visitor can generate.
#CHAT_RATE_LIMIT_PER_HOUR=20
# Site-wide, per hour. Backstop for botnets and shared proxy IPs.
#CHAT_RATE_LIMIT_GLOBAL_PER_HOUR=300
# Set to False when the app is exposed directly, with no proxy in front, so the
# client IP is taken from REMOTE_ADDR instead of X-Forwarded-For.
#DJANGO_TRUST_X_FORWARDED_FOR=True
# Where the shared rate-limit cache lives (must be writable, shared by workers).
#DJANGO_CACHE_ROOT=/data/cache
