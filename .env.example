DJANGO_SECRET_KEY=your-secret-key-here-change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
ADMIN_NOTIFICATION_EMAIL=your-email@gmail.com

# Set to False when the app is exposed directly, with no proxy in front, so the
# client IP is taken from REMOTE_ADDR instead of X-Forwarded-For.
#DJANGO_TRUST_X_FORWARDED_FOR=True
